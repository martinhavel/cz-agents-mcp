# sanctions — proměnné prostředí
#
# JEN NÁZVY A BEZPEČNÉ PLACEHOLDERY. Skutečné hodnoty patří do ~/.secrets.env
# na memini, nikdy do repozitáře.

# ── existující ────────────────────────────────────────────────────────────
SANCTIONS_DB=./sanctions.db
TOKEN_DB=./tokens.db
PORT=3030
# STRIPE_WEBHOOK_SECRET=

# ── x402 (volitelné) ──────────────────────────────────────────────────────
# Prázdné nebo chybějící X402_ENABLED = x402 je vypnuté a placený endpoint
# ani nástroj vůbec neexistují. Zapnuté a neúplné = boot padne se jménem
# chybějící proměnné. Nikdy nedegraduje na testnet.
X402_ENABLED=false

# CAIP-2, ne legacy název. Base Sepolia = eip155:84532, Base mainnet = eip155:8453.
# Řetězec "base-sepolia" je CHYBA, ne alias.
X402_NETWORK=eip155:84532

# Dvojice (síť, aktivum) musí být v ověřeném manifestu `asset-manifest.ts`.
# Base Sepolia USDC: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base mainnet USDC: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913 (nativní Circle)
X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Veřejná přijímací adresa. Server k ní NEPOTŘEBUJE privátní klíč.
X402_PAY_TO=0xYOUR_RECEIVING_ADDRESS

# Testnet: https://x402.org/facilitator (bez autentizace, jen Base Sepolia)
# Mainnet: https://api.cdp.coinbase.com/platform/v2/x402 (vyžaduje CDP klíče)
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_FACILITATOR_AUTH=none

X402_PRICE_USD=0.005

# Okno platnosti autorizace a rezerva na settlement. Rezerva MUSÍ být menší —
# klient nastavuje okno právě na maxTimeout, takže požadovat ho celý nejde splnit.
X402_MAX_TIMEOUT_SECONDS=60
X402_SETTLE_MARGIN_SECONDS=10

# true = data až po usazení platby (vědomá odchylka od HTTP konvence; u dat je
# „odesláno a platba selhala" nevratné).
X402_SETTLE_BEFORE_RELEASE=true

# Základ URL placených zdrojů — protokol chce ResourceInfo.url.
X402_RESOURCE_BASE_URL=https://cz-agents.dev/x402

# POJISTKA: mainnetová síť bez tohohle přepínače boot NEPUSTÍ. Reálné peníze
# vyžadují dvě vědomá rozhodnutí, ne jedno.
# X402_ALLOW_MAINNET=false

# CDP credentials — potřeba JEN pro mainnetový facilitátor. Hodnoty do
# ~/.secrets.env, sem nikdy.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
